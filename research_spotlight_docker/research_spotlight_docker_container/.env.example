# Hugging Face repositories containing spaCy-compatible NER pipelines.
# You can also use installed package names or local model directories.
HF_NER_METHOD=NikosKprl/en_deberta_v3_base_ner_method
HF_NER_ACTIVITY=NikosKprl/en_deberta_v3_base_ner_activity
HF_NER_GOAL=NikosKprl/en_deberta_v3_base_ner_goal

# Which service `docker compose up` starts: cpu (default). `docker compose --profile gpu up`
# overrides this for a single run; set COMPOSE_PROFILES=gpu to make the GPU the default.
COMPOSE_PROFILES=cpu

# true: runs stay in ./data after the container is reset or restarted.
# false: runs are deleted whenever the container (re)starts; download them from the UI at the end of the run.
SAVE_RUNS=false